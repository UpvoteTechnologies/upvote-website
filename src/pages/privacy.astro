---
import Base from '../layouts/Base.astro';
import { getDict } from '../i18n';
import policy from '../../content/privacy/policy.html?raw';

// The policy itself is written in Termly, in English only, so this page has one language.
// `policy` is a copy of it (`npm run sync-privacy`): it is what the prerendered page shows, and
// it stays on screen when Termly's script cannot run. Once the live embed has rendered the policy,
// it takes over.
const t = getDict('en');

// Termly finds its mount point by a `name` attribute, which is not a typed attribute on a div.
const termlyEmbed = { name: 'termly-embed', 'data-id': 'babeea2f-52c8-4655-b2ec-061c72ff9f91' };
---

<Base locale="en" title={t.meta.privacyTitle} description={t.meta.privacyDescription} path="/privacy">
  <section class="min-h-screen bg-paper py-16 lg:py-20">
    <div class="site-container">
      <a
        href="/"
        class="group mb-8 inline-flex items-center gap-2 text-[14px] font-bold text-muted transition-colors hover:text-brand"
      >
        <svg
          class="h-5 w-5 transition-transform group-hover:-translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        <span>{t.privacy.back}</span>
      </a>

      <div class="mx-auto max-w-4xl">
        <h1 class="section-title mb-8">{t.privacy.title}</h1>

        <div class="rounded-[22px] border border-line bg-white p-6 sm:p-8 md:p-12">
          <div {...termlyEmbed}></div>
          <div id="policy-copy" set:html={policy} />
        </div>
      </div>
    </div>
  </section>

  {/*
    Before Termly's script, so the listener is in place when the embed starts talking.

    The embed is a cross-origin iframe, and an iframe exists (and fires `load`) whether or not a
    policy rendered inside it: a blocked frame or an unpublished document would leave an empty box.
    The one thing only a rendered policy does is report its height to the page (the embed resizes
    its frame that way, with iframe-resizer's `[iFrameSizer]id:height:...` message). So the copy
    stays until the frame reports a height no error page reaches, and stays for good otherwise.
  */}
  <script is:inline>
    (function () {
      var copy = document.getElementById('policy-copy');
      if (!copy) return;
      function onMessage(event) {
        if (event.origin !== 'https://app.termly.io' || typeof event.data !== 'string') return;
        if (event.data.indexOf('[iFrameSizer]') !== 0) return;
        if (!(Number(event.data.split(':')[1]) > 2000)) return;
        copy.hidden = true;
        window.removeEventListener('message', onMessage);
      }
      window.addEventListener('message', onMessage);
    })();
  </script>
  <script is:inline id="termly-jssdk" src="https://app.termly.io/embed-policy.min.js"></script>
</Base>
