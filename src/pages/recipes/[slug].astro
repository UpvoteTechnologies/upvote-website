---
import Base from '../../layouts/Base.astro';
import AppCta from '../../components/AppCta.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getDict } from '../../i18n';
import { getRecipes, neighbours, recipePath } from '../../lib/content';
import { SITE_NAME, SITE_URL, absoluteUrl } from '../../site';

export function getStaticPaths() {
  // Page numbers of the index (`/recipes/2`) share this folder; a recipe slug is never a number.
  return getRecipes().map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}

const { recipe } = Astro.props;
const t = getDict('en').recipes;
const path = recipePath(recipe.slug);
const related = neighbours(getRecipes(), recipe.slug, 3);
const totalMinutes = (recipe.prepMinutes ?? 0) + (recipe.cookMinutes ?? 0);
const slots = recipe.mealSlots.map((slot) => t.slots[slot] ?? slot);

const times = [
  { label: t.prep, minutes: recipe.prepMinutes },
  { label: t.cook, minutes: recipe.cookMinutes },
  { label: t.total, minutes: totalMinutes || null },
].filter((entry) => entry.minutes);

// The page is a preview: quantities and method are in the app, so it carries no `Recipe`
// structured data (that would promise search engines a recipe the page does not contain).
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: recipe.title,
    description: recipe.blurb,
    inLanguage: 'en',
    url: absoluteUrl(path),
    ...(recipe.image ? { primaryImageOfPage: absoluteUrl(recipe.image) } : {}),
    publisher: { '@id': `${SITE_URL}/#organization`, '@type': 'Organization', name: SITE_NAME },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.breadcrumb, item: absoluteUrl('/recipes') },
      { '@type': 'ListItem', position: 2, name: recipe.title, item: absoluteUrl(path) },
    ],
  },
];
---

<Base
  locale="en"
  title={`${recipe.title}${t.titleSuffix}`}
  description={recipe.blurb}
  path={path}
  ogImage={recipe.image ?? undefined}
  ogImageSize={recipe.image ? [1024, 559] : undefined}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-[820px] px-5 pb-16 pt-10 sm:px-8 lg:pt-14">
    <nav class="text-[13px] font-bold text-muted">
      <a href="/recipes" class="transition-colors hover:text-brand">{t.breadcrumb}</a>
    </nav>
    {slots.length > 0 && <p class="label mt-6 text-brand">{slots.join(' · ')}</p>}
    <h1 class="mt-3 text-balance text-[34px] font-extrabold leading-[1.1] tracking-[-.03em] text-ink sm:text-[44px]">{recipe.title}</h1>
    <p class="mt-4 text-pretty text-[19px] font-semibold leading-[1.5] text-ink-3">{recipe.blurb}</p>

    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
      {
        recipe.servings && (
          <div>
            <dt class="label">{t.servings}</dt>
            <dd class="mt-1 text-[17px] font-extrabold text-ink">{recipe.servings}</dd>
          </div>
        )
      }
      {
        times.map((entry) => (
          <div>
            <dt class="label">{entry.label}</dt>
            <dd class="mt-1 text-[17px] font-extrabold tabular-nums text-ink">{entry.minutes} {t.minutes}</dd>
          </div>
        ))
      }
    </dl>

    {
      recipe.image && (
        <img src={recipe.image} alt={recipe.title} width="1024" height="559" fetchpriority="high" class="mt-8 aspect-[16/9] w-full rounded-[24px] object-cover" />
      )
    }

    <section class="mt-9 rounded-[24px] bg-paper-2 px-6 py-6 sm:px-8">
      <h2 class="text-[17px] font-extrabold tracking-[-.01em] text-ink">{t.ingredients}</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {recipe.ingredients.map((name) => <li class="rounded-full border border-line bg-paper px-3 py-[6px] text-[13.5px] font-semibold text-ink-2">{name}</li>)}
      </ul>
      {recipe.stepCount > 0 && <p class="mt-3 text-[13.5px] font-medium text-muted">{t.steps.replace('{n}', String(recipe.stepCount))}</p>}
    </section>

    <div class="mt-9">
      <AppCta locale="en" title={t.appTitle} body={t.appBody} />
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="border-t border-line bg-paper">
        <div class="site-container py-14">
          <h2 class="text-[24px] font-extrabold tracking-[-.02em] text-ink">{t.more}</h2>
          <div class="mt-6 grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-3">
            {related.map((item) => (
              <ContentCard href={recipePath(item.slug)} title={item.title} text={item.blurb} image={item.image} ratio={[1024, 559]} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
