---
import Base from '../layouts/Base.astro';
import Download from '../components/Download';
import { getDict } from '../i18n';

// QR codes and every "Get the app" button land here. The component reads the device in the
// browser and forwards to the right store. The two store links are in the prerendered HTML, so
// a visitor without JavaScript (or with the bundle blocked) can still get the app.
const t = getDict('en');
---

<Base
  locale="en"
  title={t.meta.downloadTitle}
  description={t.meta.homeDescription}
  path="/download"
  noindex
  chrome={false}
>
  <Download client:load />
</Base>
