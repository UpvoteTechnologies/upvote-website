---
// Renders an article body from the app's typed blocks. `citation` blocks are not drawn inline:
// every source is listed once at the end of the article by the page.
import Spans from './Spans.astro';
import { getDict, type Locale } from '../i18n';
import type { ArticleBlock } from '../lib/content';

interface Props {
  locale: Locale;
  blocks: ArticleBlock[];
}

const { locale, blocks } = Astro.props;
const t = getDict(locale).articles;
const number = new Intl.NumberFormat(locale === 'pt-br' ? 'pt-BR' : 'en-US');
// Some captions only make sense on a phone ("Tap to see how we counted").
const showCaption = (caption?: string) => caption && !/^tap\b/i.test(caption);
---

{
  blocks.map((block) => {
    switch (block.kind) {
      case 'paragraph':
        return (
          <p class="mt-5 text-pretty text-[17px] font-medium leading-[1.7] text-ink-2">
            <Spans spans={block.spans} />
          </p>
        );
      case 'heading':
        return (
          <h2 class="mt-11 text-[24px] font-extrabold tracking-[-.02em] text-ink sm:text-[28px]">
            <Spans spans={block.spans} />
          </h2>
        );
      case 'list': {
        const List = block.ordered ? 'ol' : 'ul';
        return (
          <List class:list={['mt-5 flex flex-col gap-2 pl-6 text-[17px] font-medium leading-[1.6] text-ink-2', block.ordered ? 'list-decimal' : 'list-disc']}>
            {block.items.map((item) => (
              <li>
                <Spans spans={item} />
              </li>
            ))}
          </List>
        );
      }
      case 'callout':
        return (
          <div class:list={['mt-7 rounded-[18px] border px-6 py-5', block.tone === 'caution' ? 'border-[#E8D9A8] bg-[#FBF4DC]' : 'border-line bg-paper-2']}>
            {block.title && <p class="mb-1 text-[15px] font-extrabold text-ink">{block.title}</p>}
            <p class="text-pretty text-[16px] font-semibold leading-[1.6] text-ink">
              <Spans spans={block.spans} />
            </p>
          </div>
        );
      case 'uncertainty':
        return (
          <div class="mt-9 rounded-[18px] border border-line bg-paper-2 px-6 py-5">
            <p class="eyebrow">{t.whatWeDoNotKnow}</p>
            <p class="mt-2 text-pretty text-[15px] font-medium leading-[1.6] text-ink-3">
              <Spans spans={block.spans} />
            </p>
          </div>
        );
      case 'figure':
        return block.resolved ? (
          <figure class="mt-6 rounded-[18px] border border-line bg-paper-2 px-6 py-5">
            <p class="font-mono text-[34px] font-bold leading-none text-brand">{block.resolved.value}</p>
            <figcaption class="mt-2">
              <span class="text-[15px] font-extrabold text-ink">{block.label}</span>
              {showCaption(block.caption) && <span class="mt-1 block text-[14px] font-medium leading-[1.55] text-ink-3">{block.caption}</span>}
              {block.resolved.method && <span class="mt-1 block text-[13px] font-medium leading-[1.55] text-muted">{block.resolved.method}</span>}
              <span class="mt-1 block text-[13px] font-medium leading-[1.55] text-muted">
                {typeof block.resolved.n === 'number' && t.figureCount.replace('{n}', number.format(block.resolved.n))}
                {block.resolved.excludedNote && ` ${block.resolved.excludedNote}`}
                {block.resolved.limit && ` ${block.resolved.limit}`}
              </span>
            </figcaption>
          </figure>
        ) : null;
      case 'terms':
        return (
          <ul class="mt-5 flex flex-wrap gap-2">
            {block.items.map((item) => (
              <li class="rounded-full border border-line bg-paper-2 px-3 py-[6px] text-[13.5px] font-semibold text-ink-2">{item}</li>
            ))}
          </ul>
        );
      case 'plan':
        return (
          <dl class="mt-7 rounded-[18px] bg-brand-soft px-6 py-5 text-[16px] leading-[1.55]">
            <dt class="eyebrow">{t.planCue}</dt>
            <dd class="font-semibold text-ink">{block.cue}</dd>
            <dt class="eyebrow mt-3">{t.planAction}</dt>
            <dd class="font-extrabold text-brand-dark">{block.action}</dd>
          </dl>
        );
      default:
        return null;
    }
  })
}
