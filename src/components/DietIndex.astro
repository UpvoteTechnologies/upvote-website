---
import Base from '../layouts/Base.astro';
import AppCta from './AppCta.astro';
import { LOCALES, getDict, type Locale } from '../i18n';
import { dietIndexPath, dietPath, getDiets } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const t = dict.dietPages;
const alternates = Object.fromEntries(LOCALES.map((code) => [code, dietIndexPath(code)]));
---

<Base locale={locale} title={t.indexTitle} description={t.indexDescription} path={dietIndexPath(locale)} alternates={alternates}>
  <section class="site-container pb-16 pt-12 lg:pt-16">
    <h1 class="section-title">{t.indexHeading}</h1>
    <p class="section-lead mt-[14px] max-w-[720px]">{t.indexLead}</p>

    <div class="mt-10 grid grid-cols-1 gap-x-12 border-b border-line-2 md:grid-cols-2">
      {
        getDiets().map((diet) => (
          <a href={dietPath(locale, diet)} class="group flex flex-col border-t border-line-2 py-6">
            <h2 class="text-[20px] font-extrabold tracking-[-.015em] text-ink transition-colors group-hover:text-brand">{diet[locale].name}</h2>
            <p class="mt-2 max-w-[480px] text-pretty text-[14.5px] font-medium leading-[1.55] text-muted">{diet[locale].summary}</p>
          </a>
        ))
      }
    </div>

    <p class="mt-8 max-w-[760px] text-[12.5px] font-medium leading-[1.6] text-muted">{dict.diets.disclaimer}</p>

    <div class="mt-12">
      <AppCta locale={locale} />
    </div>
  </section>
</Base>
