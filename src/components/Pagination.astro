---
import { getDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  current: number;
  last: number;
  previous?: string;
  next?: string;
}

const { locale, current, last, previous, next } = Astro.props;
const t = getDict(locale).pagination;
const link = 'rounded-full border border-line px-5 py-[10px] text-[14px] font-extrabold text-ink-2 transition-colors hover:border-brand hover:text-brand';
---

{
  last > 1 && (
    <nav aria-label={t.label} class="mt-12 flex items-center justify-center gap-4">
      {previous && <a href={previous} rel="prev" class={link}>{t.previous}</a>}
      <span class="text-[14px] font-bold tabular-nums text-muted">{current} / {last}</span>
      {next && <a href={next} rel="next" class={link}>{t.next}</a>}
    </nav>
  )
}
