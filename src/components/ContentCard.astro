---
interface Props {
  href: string;
  title: string;
  text: string;
  eyebrow?: string;
  image: string | null;
  /** Width and height of the source image, to reserve its space before it loads. */
  ratio: [number, number];
}

const { href, title, text, eyebrow, image, ratio } = Astro.props;
---

<a href={href} class="group flex flex-col">
  {
    image && (
      <img src={image} alt="" width={ratio[0]} height={ratio[1]} loading="lazy" decoding="async" class="aspect-[16/9] w-full rounded-[24px] bg-paper-2 object-cover" />
    )
  }
  <div class={`flex flex-1 flex-col ${image ? 'pt-4' : 'border-t border-line-2 pt-4'}`}>
    {eyebrow && <p class="label text-brand">{eyebrow}</p>}
    <h3 class="mt-1 text-[18px] font-extrabold leading-[1.25] tracking-[-.015em] text-ink transition-colors group-hover:text-brand">{title}</h3>
    <p class="mt-2 text-pretty text-[14px] font-medium leading-[1.55] text-muted">{text}</p>
  </div>
</a>
