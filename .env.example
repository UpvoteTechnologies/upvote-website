# Resend (existing)
RESEND_API_KEY=

# Supabase (for track-download function)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics and search verification (public, read at build time; both optional)
PUBLIC_POSTHOG_KEY=
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Catalog API base URL, used only by `npm run sync-content` (never by the build)
CATALOG_API_URL=
