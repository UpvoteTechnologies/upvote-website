{
  "slug": "creamy-mushroom-soup",
  "title": "Creamy Mushroom Soup",
  "blurb": "A smooth soup with earthy mushrooms and a touch of thyme, finished with cream.",
  "steps": [
    "Heat the olive oil in a large saucepan over medium heat and cook the shallots for 4 minutes until softened.",
    "Add the mushrooms and garlic, then cook for 8 minutes, stirring occasionally, until the mushrooms release their moisture and start to brown.",
    "Stir in the thyme and flour, coating the mushrooms well, and cook for 1 minute.",
    "Pour in the water and crumble in the stock cube, stirring to combine. Bring to a simmer and cook for 10 minutes.",
    "Use a stick blender to purée the soup until smooth, or leave it slightly chunky if you prefer.",
    "Stir in the cream and heat gently for 2 minutes without boiling. Season with salt and pepper to taste."
  ],
