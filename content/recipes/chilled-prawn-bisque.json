{
  "slug": "chilled-prawn-bisque",
  "title": "Chilled Prawn Bisque",
  "blurb": "A smooth, chilled soup with prawns and thyme, perfect for warm weather.",
  "steps": [
    "Melt the butter in a large pan over medium heat and cook the onion for 5 minutes until softened.",
    "Add the prawns and cook for 2 minutes until they turn pink.",
    "Pour in the clam juice, fish stock, thyme and tomato purée, then bring to a simmer and cook for 8 minutes.",
    "Remove from the heat and blend the soup until completely smooth using a stick blender or food processor.",
    "Stir in the cream and season with salt.",
    "Transfer to a container and refrigerate for at least 2 hours until thoroughly chilled before serving."
