{
  "slug": "apple-and-oat-crisp",
  "title": "Apple and Oat Crisp",
  "blurb": "Warm baked apples with a golden oat topping, best served with vanilla ice cream.",
  "steps": [
    "Heat your oven to 180°C.",
    "Peel and core the apples, then cut them into roughly 2cm chunks and spread them in a baking dish.",
    "Sprinkle half the cinnamon over the apples.",
    "In a bowl, rub the butter into the oats and sugar with your fingers until the mixture looks like rough breadcrumbs, then stir through the remaining cinnamon.",
    "Scatter the oat mixture evenly over the apples.",
    "Bake for 30 minutes until the topping is golden and the apples are soft when you press them with a spoon.",
    "Serve warm with scoops of vanilla ice cream."
  ],
