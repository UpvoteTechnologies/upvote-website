{
  "slug": "baked-oregano-and-garlic-cheese-squares",
  "title": "Baked Oregano and Garlic Cheese Squares",
  "blurb": "A savoury baked slice with herbs, garlic and melted cheese, cut into squares for a light lunch or snack.",
  "steps": [
    "Preheat your oven to 180°C and grease a 20cm square baking tin with a little of the olive oil.",
    "Whisk the eggs in a large bowl until well combined, then stir in the cheese, flour, baking powder, oregano and black pepper.",
    "Add the crushed garlic, chopped parsley and remaining olive oil, mixing until you have a thick batter.",
    "Pour the mixture into the prepared tin and spread it evenly to the edges.",
    "Bake for 35 minutes until golden on top and set in the centre.",
    "Leave to cool for 5 minutes in the tin, then turn out and cut into 8 squares."
  ],
