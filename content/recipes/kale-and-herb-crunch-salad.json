{
  "slug": "kale-and-herb-crunch-salad",
  "title": "Kale and Herb Crunch Salad",
  "blurb": "A fresh, crunchy salad with kale, red onion, herbs and a simple lemon dressing",
  "steps": [
    "Wash and dry the kale, then slice it very finely into thin ribbons and place in a large bowl.",
    "Peel and finely chop the red onion, mince the garlic, and chop the parsley and thyme.",
    "Dice the cucumber into small cubes and halve the cherry tomatoes.",
    "Add the onion, cucumber, tomatoes, herbs and garlic to the kale.",
    "Squeeze the lemon juice into a small bowl, add the olive oil, salt and pepper, and whisk together.",
    "Pour the dressing over the salad and massage it into the kale with your hands for two minutes to soften the leaves.",
    "Cover and refrigerate for at least 45 minutes to let the flavours develop.",
    "Scatter the pumpkin seeds over the top just before serving."
  ],
