{
  "slug": "courgette-and-avocado-soup",
  "title": "Courgette and Avocado Soup",
  "blurb": "A light, creamy soup with courgette and avocado, brightened with lemon and ginger.",
  "steps": [
    "Peel and chop the onion, peel and crush the garlic, peel and grate the ginger, then trim and chop the courgettes into chunks.",
    "Heat the olive oil in a large pan over medium heat, add the onion and cook for 3 minutes until softened.",
    "Add the garlic and ginger, cook for 1 minute, then add the courgettes and stir.",
    "Dissolve the stock cube in the water, pour into the pan and bring to a simmer.",
    "Simmer for 10 minutes until the courgettes are tender.",
    "Halve the avocado, remove the stone and scoop the flesh into the pan.",
    "Remove from the heat, add the lemon juice, then blend until smooth with a stick blender.",
    "Season with black pepper and serve warm."
  ],
