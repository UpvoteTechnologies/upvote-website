{
  "slug": "chocolate-walnut-cookies",
  "title": "Chocolate Walnut Cookies",
  "blurb": "Soft cookies with cocoa and walnuts, made with soy flour for a nutty wholesome base.",
  "steps": [
    "Heat your oven to 180°C and line two baking trays with parchment.",
    "Beat the butter and sugar together until pale and creamy.",
    "Add the eggs, vanilla extract and cream, then beat until smooth.",
    "Stir in the soy flour, cocoa powder, baking powder and salt until just combined.",
    "Roughly chop the walnuts and fold them through the mixture.",
    "Drop heaped teaspoons of the dough onto the trays, spacing them apart.",
    "Bake for 6 minutes until just set but still soft in the centre, then cool on a wire rack."
