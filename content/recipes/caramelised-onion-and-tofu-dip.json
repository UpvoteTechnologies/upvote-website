{
  "slug": "caramelised-onion-and-tofu-dip",
  "title": "Caramelised Onion and Tofu Dip",
  "blurb": "Slowly cooked onions blended with silken tofu make a smooth, savoury dip with a gentle heat.",
  "steps": [
    "Heat the olive oil in a wide frying pan over medium heat and add the sliced onions with a pinch of salt.",
    "Cook the onions for 20 to 25 minutes, stirring occasionally, until they are soft and deeply golden brown.",
    "Transfer the caramelised onions to a food processor and add the drained tofu, hot pepper sauce, remaining salt, onion granules and black pepper.",
    "Blend until completely smooth, scraping down the sides as needed.",
    "Taste and adjust the seasoning, then transfer to a serving bowl.",
    "Serve at room temperature with vegetable sticks or crackers."
  ],
