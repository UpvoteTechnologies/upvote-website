{
  "slug": "mini-chocolate-chip-muffins",
  "title": "Mini Chocolate Chip Muffins",
  "blurb": "Small, lightly sweet muffins with a nutty flavour from soy flour and scattered chocolate chips throughout.",
  "steps": [
    "Heat your oven to 180°C and line two mini muffin tins with paper cases.",
    "Mix the soy flour and baking powder together in a bowl.",
    "Pour in the melted butter and water, then stir until you have a smooth batter.",
    "Fold in the chocolate chips so they are evenly distributed.",
    "Spoon the batter into the muffin cases, filling each about three-quarters full.",
    "Bake for 15 minutes until the muffins are golden and springy to touch.",
    "Remove from the tin and cool on a wire rack before serving."
