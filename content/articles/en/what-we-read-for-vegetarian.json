{
  "slug": "what-we-read-for-vegetarian",
  "kicker": "DIETS",
  "title": "What we read for Vegetarian",
  "standfirst": "The names this plan looks for on a label, and where the list stops.",
  "evidenceTier": "moderate",
  "sourceLabel": "Moderate evidence",
  "image": "/media/articles/what-we-read-for-vegetarian.jpg",
  "blocks": [
    {
      "kind": "paragraph",
      "key": "b1",
      "spans": [
        {
          "text": "When you turn this plan on, we read the ingredient list on a label and look for a set of names. This is that set, in full."
        }
      ]
    },
    {
      "kind": "paragraph",
      "key": "b2",
      "spans": [
        {
          "text": "We show it because a plan that marks a food off-plan should be able to say which word did it."
        }
      ]
    },
    {
      "kind": "heading",
      "key": "b3",
      "spans": [
        {
          "text": "The names we read"
        }
      ]
    },
